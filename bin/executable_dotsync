#!/usr/bin/env bash
# dotsync -- one command to reconcile this machine with the dotfiles repo.
#
#   1. pulls local edits to managed files back into the chezmoi source repo
#   2. secret-scans that source tree; a hit stops everything before it leaves
#   3. ASKS before sending anything to GitHub, then commits and pushes
#   4. pulls whatever another machine pushed, reports what it changed, and
#      applies it here
#   5. reloads herdr's config, the one running program here that can re-read
#      it in place, and names anything else that needs a restart
#
# Step 3 always asks. Declining skips the commit and the push; the pull and
# apply still run, so "no" still gets this machine up to date. Local edits
# stay in the source repo, uncommitted, waiting for the next run.
#
# Usage: dotsync [-y|--yes] [-n|--no-push] ["commit message"]
#   -y  push without asking (for scripts and non-interactive runs)
#   -n  never push this run; just pull and apply
set -euo pipefail

SRC="$(chezmoi source-path)"
MODE=ask
MSG=""

while [ $# -gt 0 ]; do
  case "$1" in
    -y|--yes)     MODE=yes ;;
    -n|--no-push) MODE=no ;;
    -h|--help)    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)           echo "dotsync: unknown option $1" >&2; exit 2 ;;
    *)            MSG="$1" ;;
  esac
  shift
done
MSG="${MSG:-dotsync from $(hostname -s) on $(date +%Y-%m-%d)}"

# `git push` over an https remote hangs on a macOS Keychain dialog that a
# non-interactive session can never approve, so an https remote is pushed
# with a gh-issued token instead. An ssh remote needs none of this.
git_remote_auth() {
  local url
  url="$(git -C "$SRC" remote get-url origin)"
  if [[ "$url" == https://* ]] && command -v gh >/dev/null 2>&1; then
    local tok
    tok="$(gh auth token --hostname github.com)"
    printf '%s\0%s\0' \
      '-c' "http.https://github.com/.extraheader=Authorization: basic $(printf 'x-access-token:%s' "$tok" | base64)"
  fi
}

git_net() {
  local -a auth=()
  while IFS= read -r -d '' arg; do auth+=("$arg"); done < <(git_remote_auth)
  git -C "$SRC" -c credential.helper= "${auth[@]}" "$@"
}

echo "==> Capturing local edits to managed files"
chezmoi re-add

echo "==> Secret scan"
if rg -n --glob '!.git' \
  -e 'gh[pousr]_[A-Za-z0-9]{36}' \
  -e 'sk-ant-[A-Za-z0-9_-]{20,}' \
  -e 'AKIA[0-9A-Z]{16}' \
  -e 'BEGIN [A-Z ]*PRIVATE KEY' \
  -e 'SNC_INSTANCES\s*[:=]\s*\S' \
  -e '(?i)(password|passwd|api[_-]?key|secret|token)"?\s*[:=]\s*["'"'"'][^"'"'"']{12,}' \
  "$SRC"; then
  echo "dotsync: secret scan hit the lines above. Nothing committed, nothing pushed." >&2
  exit 1
fi

# Everything that would leave this machine: uncommitted edits, plus any
# commits made on an earlier run that never got pushed.
DIRTY="$(git -C "$SRC" status --porcelain)"
UNPUSHED="$(git -C "$SRC" log --oneline @{u}..HEAD 2>/dev/null || true)"

PUSH=no
if [ -z "$DIRTY" ] && [ -z "$UNPUSHED" ]; then
  echo "==> Nothing local to send"
else
  echo "==> Local changes not yet on GitHub:"
  [ -n "$DIRTY" ] && git -C "$SRC" status --short | sed 's/^/    /'
  [ -n "$UNPUSHED" ] && echo "$UNPUSHED" | sed 's/^/    unpushed commit: /'

  case "$MODE" in
    yes) PUSH=yes ;;
    no)  echo "    (-n given, skipping)" ;;
    ask)
      if [ -t 0 ]; then
        while true; do
          printf 'Send these to GitHub? [y]es / [n]o / [d]iff: '
          read -r reply </dev/tty
          case "$reply" in
            [Yy]*) PUSH=yes; break ;;
            [Dd]*) git -C "$SRC" --no-pager diff; git -C "$SRC" --no-pager diff --cached ;;
            *)     echo "    skipped -- run 'dotsync' again, or 'dotsync -y', when ready"; break ;;
          esac
        done
      else
        echo "    no terminal to ask on, skipping -- use 'dotsync -y' to push non-interactively"
      fi
      ;;
  esac
fi

if [ "$PUSH" = yes ] && [ -n "$DIRTY" ]; then
  echo "==> Committing"
  git -C "$SRC" add -A
  git -C "$SRC" commit -q -m "$MSG"
fi

echo "==> Pulling from GitHub"
BEFORE_REV="$(git -C "$SRC" rev-parse HEAD)"
git_net pull --rebase --autostash || {
  echo "dotsync: pull stopped, most likely a conflict. Resolve it in $SRC" >&2
  echo "         ('git status' there will say whether it's a rebase or a stash pop)," >&2
  echo "         then re-run dotsync." >&2
  exit 1
}

AFTER_REV="$(git -C "$SRC" rev-parse HEAD)"
if [ "$BEFORE_REV" != "$AFTER_REV" ]; then
  echo "    picked up $(git -C "$SRC" rev-list --count "$BEFORE_REV..$AFTER_REV") commit(s):"
  git -C "$SRC" log --oneline --no-decorate "$BEFORE_REV..$AFTER_REV" | sed 's/^/      /'
fi

if [ "$PUSH" = yes ]; then
  echo "==> Pushing to GitHub"
  git_net push
fi

# What apply is about to change in $HOME. `chezmoi re-add` above already made
# the source match this machine for every managed file, so anything still
# listed here arrived in the pull -- i.e. it is exactly what another machine
# changed.
PENDING="$(chezmoi status 2>/dev/null || true)"
if [ -n "$PENDING" ]; then
  echo "==> Changing on this machine:"
  printf '%s\n' "$PENDING" | sed 's/^/    /'
else
  echo "==> Nothing on this machine to change"
fi

echo "==> Applying to this machine"
chezmoi apply

# chezmoi only writes files; a program already running keeps using the config
# it read at startup. herdr is the one piece of this setup that can re-read
# its config in place, so do it here. Guarded on the socket so this is a no-op
# when herdr isn't running -- and skipped entirely if HERDR_CONFIG_PATH points
# somewhere else, since then the socket location is not ours to guess.
HERDR="$HOME/.local/bin/herdr"
if [ -x "$HERDR" ] && [ -z "${HERDR_CONFIG_PATH:-}" ] && [ -S "$HOME/.config/herdr/herdr.sock" ]; then
  echo "==> Reloading herdr config"
  "$HERDR" server reload-config >/dev/null 2>&1 \
    || echo "    reload failed -- run 'herdr server reload-config' by hand" >&2
fi

# Ghostty, zsh and nvim have no reload equivalent: their configs are on disk
# now, but a running instance keeps using what it read at startup. Only say so
# for the ones that actually changed this run.
if [ -n "$PENDING" ]; then
  RESTARTS=""
  add_restart() {
    if printf '%s\n' "$PENDING" | rg -q "$1"; then
      RESTARTS="${RESTARTS}    $2"$'\n'
    fi
  }
  add_restart 'config/ghostty' 'Ghostty -- Cmd+Shift+, or relaunch it'
  add_restart 'config/zsh'     'zsh -- open a new shell (or: exec zsh)'
  add_restart 'config/nvim'    'nvim -- relaunch it'
  if [ -n "$RESTARTS" ]; then
    echo "==> Not picked up until you restart:"
    printf '%s' "$RESTARTS"
  fi
fi

echo "==> dotsync complete"
