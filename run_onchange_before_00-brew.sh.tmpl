#!/usr/bin/env bash
# Installs everything brew-installable in this workflow. herdr itself is not
# on Homebrew (see run_once_after_10) -- everything else is.
#
# run_onchange_, not run_once_: this script only reads Brewfile/Brewfile.darwin
# at runtime, it doesn't embed their contents, so chezmoi's run_once tracking
# (hashes the script's own rendered content) is blind to edits made to either
# file. Hit this for real: added neovim/ripgrep/yazi to Brewfile, ran
# `chezmoi update` on a already-set-up machine, and 00-brew never re-ran
# because this script file itself hadn't changed. The hashes below make the
# script's own content change whenever either Brewfile does, forcing a rerun.
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
# Brewfile.darwin hash: {{ include "Brewfile.darwin" | sha256sum }}
#
# Cross-platform: Homebrew's own installer supports Linux (Linuxbrew) as well
# as macOS, so a fresh EC2/Linux box gets the same one-liner as a fresh Mac.
# Ghostty is a GUI app with no reason to run on a headless remote box (you'd
# SSH into it *from* Ghostty locally instead), so its cask lives in the
# macOS-only Brewfile.darwin, kept out of the base Brewfile entirely.
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Linuxbrew has two possible prefixes depending on whether the installer
# could sudo: /home/linuxbrew/.linuxbrew (multi-user, needs sudo) or
# $HOME/.linuxbrew (single-user fallback -- what a non-root, no-sudo
# Coder/EC2 user actually gets). Resolved to an absolute path unconditionally
# (not just after a fresh install, and not just via `command -v`) so it's
# available below for persisting into .bashrc, and so this still works on
# reruns where brew was already installed by an earlier pass.
BREW_BIN=""
for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
  if [ -x "$candidate" ]; then
    BREW_BIN="$candidate"
    break
  fi
done
[ -n "$BREW_BIN" ] || BREW_BIN="$(command -v brew || true)"

[ -n "$BREW_BIN" ] || { echo "Homebrew install did not produce a brew binary" >&2; exit 1; }

eval "$("$BREW_BIN" shellenv)"

# NONINTERACTIVE=1 skips Homebrew's own "add this to your shell profile" step
# (it printed the exact fix on a real box: `echo 'eval "$(.../brew shellenv
# bash)"' >> ~/.bashrc`) -- without persisting it ourselves, brew resolves
# fine inside this script's own process but every *new* shell afterward
# (this one's PATH change dies with this process) still can't find brew, or
# anything brew installs: zsh, nvim, rg, yazi. Idempotent marker, same
# pattern as run_once_after_05's .zshrc append. .zshrc itself is already
# covered by this same bootstrap living in workflow.zsh.
BASHRC="$HOME/.bashrc"
MARKER="# dotfiles: homebrew shellenv"
touch "$BASHRC"
if ! grep -qF "$MARKER" "$BASHRC"; then
  printf '\n%s\neval "$(%s shellenv)"\n' "$MARKER" "$BREW_BIN" >> "$BASHRC"
fi

brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile"

{{ if eq .chezmoi.os "darwin" -}}
brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile.darwin"
{{ end -}}
