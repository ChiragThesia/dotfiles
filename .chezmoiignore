# Source-repo files with no target in $HOME. Without these, chezmoi writes
# README.md / Brewfile / claude-settings-patch.json straight into the home
# directory. Scripts still reach them via {{ .chezmoi.sourceDir }}.
README.md
Brewfile
claude-settings-patch.json

# Machines that keep their own real, customized versions of files this repo
# also carries a generic version of -- applying here would silently revert
# real, intentional divergence. "Chiragss-MacBook-Pro" was already here
# (unverified whether it's a real second machine or a guess -- kept rather
# than removed, since dropping it if it IS real would be worse than a dead
# entry if it isn't). MACGF99RXQFQY is this repo's own authoring machine,
# confirmed via `chezmoi execute-template '{{ .chezmoi.hostname }}'` -- its
# real ~/.claude/CLAUDE.md carries ServiceNow-specific sections this repo's
# copy also has (so CLAUDE.md itself doesn't strictly need protecting here,
# but costs nothing to include), and its real worktrunk/config.toml carries
# post-start hooks (open-wt-session, codegraph) this repo's copy deliberately
# strips.
{{ if or (eq .chezmoi.hostname "Chiragss-MacBook-Pro") (eq .chezmoi.hostname "MACGF99RXQFQY") }}
.claude/CLAUDE.md
.config/worktrunk/config.toml
{{ end }}
