# Source-repo files with no target in $HOME. Without these, chezmoi writes
# README.md / Brewfile / claude-settings-patch.json straight into the home
# directory. Scripts still reach them via {{ .chezmoi.sourceDir }}.
README.md
install.sh
Brewfile
Brewfile.darwin
claude-settings-patch.json
docs

# Files a given machine keeps its own real, diverged version of. Applying
# this repo's generic copy there would silently revert real customization.
# Scoped per machine, per file: an entry only belongs here on a machine that
# actually diverges, otherwise that machine silently stops tracking the repo.
#
# personal-machine is a real second machine (this is where dotsync was
# written). Its ~/.claude/CLAUDE.md is a lean global one, deliberately not
# this repo's Acme-heavy copy. Its worktrunk config is byte-identical
# to the repo's, so it is NOT listed below -- it should keep tracking.
#
# work-machine is this repo's authoring machine. Its real worktrunk config
# carries post-start hooks (open-wt-session, codegraph) this repo's copy
# deliberately strips.
{{ if or (eq .chezmoi.hostname "personal-machine") (eq .chezmoi.hostname "work-machine") }}
.claude/CLAUDE.md
{{ end }}
{{ if eq .chezmoi.hostname "work-machine" }}
.config/worktrunk/config.toml
{{ end }}
