# Source-repo files with no target in $HOME. Without these, chezmoi writes
# README.md / Brewfile / claude-settings-patch.json straight into the home
# directory. Scripts still reach them via {{ .chezmoi.sourceDir }}.
README.md
install.sh
Brewfile
Brewfile.darwin
claude-settings-patch.json
docs

# Files a given machine keeps its own real, diverged version of. Applying
# this repo's generic copy there would silently revert real customization.
# Opt out per machine, per file, by touching a marker -- an entry only
# belongs here on a machine that actually diverges, otherwise that machine
# silently stops tracking the repo.
#
#   mkdir -p ~/.config/chezmoi/keep-local
#   touch ~/.config/chezmoi/keep-local/claude-md      # keep my own CLAUDE.md
#   touch ~/.config/chezmoi/keep-local/worktrunk      # keep my own worktrunk config
#
# Markers, not hostnames: a hostname list has to name real machines in a
# public repo, and it silently breaks the moment a machine is renamed.
{{ if stat (joinPath .chezmoi.homeDir ".config/chezmoi/keep-local/claude-md") }}
.claude/CLAUDE.md
{{ end }}
{{ if stat (joinPath .chezmoi.homeDir ".config/chezmoi/keep-local/worktrunk") }}
.config/worktrunk/config.toml
{{ end }}
